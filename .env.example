# Option-Only Markowitz standalone project environment template.
# Copy this file to .env and fill only the keys/sources you are licensed to use.
# Never commit .env.

# -----------------------------------------------------------------------------
# General local paths and date windows
# -----------------------------------------------------------------------------
OPTION_MARKOWITZ_DATA_DIR=data
OPTION_MARKOWITZ_DOWNLOAD_START=2015-01-01
OPTION_MARKOWITZ_DOWNLOAD_END=2026-06-10
OPTION_MARKOWITZ_UNDERLYINGS=AAPL,AMZN,GOOGL,JPM,META,MSFT,NVDA,TSLA

# -----------------------------------------------------------------------------
# Paid/licensed market data
# -----------------------------------------------------------------------------
# Databento historical API key for OPRA and exchange data pulls.
DATABENTO_API_KEY=
DATABENTO_API_KEY2=

# Optional alternate vendors used by non-headline exploratory or extension paths.
FRED_API_KEY=
LSEG_APP_KEY=
LSEG_APP_KEY_SIDE_BY_SIDE=
LSEG_APP_KEY_EIKON=
WRDS_USERNAME=
WRDS_PASSWORD=

# -----------------------------------------------------------------------------
# Exact VIX final settlement values
# -----------------------------------------------------------------------------
OPTION_MARKOWITZ_VRO_OUTPUT_DIR=data/public/cboe/vro_soq
OPTION_MARKOWITZ_VRO_FILE=
OPTION_MARKOWITZ_VRO_DIR=

# -----------------------------------------------------------------------------
# Local runner controls
# -----------------------------------------------------------------------------
PYTHONHASHSEED=0
